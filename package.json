{
  "name": "iconotype",
  "private": true,
  "type": "module",
  "version": "0.2.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @iconotype/web dev",
    "build": "pnpm -r --filter './apps/*' build",
    "build:vscode": "pnpm --filter iconotype-vscode build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vscode": "pnpm --filter iconotype-vscode test",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit",
    "spike:paper": "pnpm --filter spike-paper-headless exec node spike.mjs",
    "demo": "node scripts/demo-capture.mjs",
    "social": "pnpm --filter @iconotype/cli exec node scripts/social-preview.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^26.2.0",
    "@types/opentype.js": "^1.3.10",
    "playwright": "^1.62.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
