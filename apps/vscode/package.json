{
  "name": "iconotype-vscode",
  "displayName": "Iconotype — icon fonts",
  "icon": "media/icon.png",
  "publisher": "iconotype",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "workspaceContains:**/*.iconotype.json",
    "workspaceContains:**/*.glyphsmith.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "iconotype.open",
        "title": "Open Editor",
        "category": "Iconotype",
        "icon": "$(edit)"
      },
      {
        "command": "iconotype.export",
        "title": "Export Font",
        "category": "Iconotype",
        "icon": "$(export)"
      },
      {
        "command": "iconotype.exportAll",
        "title": "Export All Fonts",
        "category": "Iconotype",
        "icon": "$(export)"
      },
      {
        "command": "iconotype.addIcons",
        "title": "Add Icons from SVG…",
        "category": "Iconotype",
        "icon": "$(add)"
      },
      {
        "command": "iconotype.removeIcon",
        "title": "Remove Icon",
        "category": "Iconotype",
        "icon": "$(trash)"
      },
      {
        "command": "iconotype.toggleIcon",
        "title": "Include/Exclude from Export",
        "category": "Iconotype",
        "icon": "$(check)"
      },
      {
        "command": "iconotype.insertIcon",
        "title": "Insert Icon Reference…",
        "category": "Iconotype",
        "icon": "$(symbol-color)"
      },
      {
        "command": "iconotype.scanUsage",
        "title": "Scan Icon Usage",
        "category": "Iconotype",
        "icon": "$(search)"
      },
      {
        "command": "iconotype.newFont",
        "title": "New Icon Font…",
        "category": "Iconotype",
        "icon": "$(new-file)"
      },
      {
        "command": "iconotype.revealIcon",
        "title": "Show Icon in Grid",
        "category": "Iconotype"
      },
      {
        "command": "iconotype.importProject",
        "title": "Import IcoMoon Project…",
        "category": "Iconotype",
        "icon": "$(cloud-download)"
      },
      {
        "command": "iconotype.importIcons",
        "title": "Add Icons from Project or Zip…",
        "category": "Iconotype",
        "icon": "$(library)"
      },
      {
        "command": "iconotype.showUsage",
        "title": "Show Icon Usage",
        "category": "Iconotype",
        "icon": "$(references)"
      },
      {
        "command": "iconotype.replaceIcon",
        "title": "Replace Icon Artwork…",
        "category": "Iconotype",
        "icon": "$(replace)"
      },
      {
        "command": "iconotype.flattenIcon",
        "title": "Flatten to One Colour",
        "category": "Iconotype",
        "icon": "$(color-mode)"
      },
      {
        "command": "iconotype.exportPending",
        "title": "Export Fonts With Pending Changes",
        "category": "Iconotype",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iconotype",
          "title": "Icon Fonts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "iconotype": [
        {
          "id": "iconotype.iconGrid",
          "name": "Icons",
          "type": "webview"
        },
        {
          "id": "iconotype.fonts",
          "name": "Fonts"
        },
        {
          "id": "iconotype.usage",
          "name": "Usage"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "iconotype.importProject",
          "when": "view == iconotype.fonts",
          "group": "navigation@0"
        },
        {
          "command": "iconotype.importProject",
          "when": "view == iconotype.iconGrid",
          "group": "navigation@0"
        },
        {
          "command": "iconotype.newFont",
          "when": "view == iconotype.fonts",
          "group": "navigation@1"
        },
        {
          "command": "iconotype.exportAll",
          "when": "view == iconotype.fonts",
          "group": "navigation@2"
        },
        {
          "command": "iconotype.scanUsage",
          "when": "view == iconotype.usage",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "iconotype.export",
          "when": "view == iconotype.fonts && viewItem == iconotype.font",
          "group": "inline@1"
        },
        {
          "command": "iconotype.addIcons",
          "when": "view == iconotype.fonts && viewItem == iconotype.font",
          "group": "inline@2"
        },
        {
          "command": "iconotype.importIcons",
          "when": "view == iconotype.fonts && viewItem == iconotype.font",
          "group": "iconotype@1"
        },
        {
          "command": "iconotype.open",
          "when": "view == iconotype.fonts && viewItem == iconotype.font",
          "group": "inline@3"
        },
        {
          "command": "iconotype.toggleIcon",
          "when": "view == iconotype.fonts && viewItem =~ /iconotype.icon/",
          "group": "inline@1"
        },
        {
          "command": "iconotype.removeIcon",
          "when": "view == iconotype.fonts && viewItem =~ /iconotype.icon/",
          "group": "inline@2"
        },
        {
          "command": "iconotype.showUsage",
          "when": "view == iconotype.fonts && viewItem =~ /iconotype.icon/",
          "group": "iconotype@1"
        },
        {
          "command": "iconotype.replaceIcon",
          "when": "view == iconotype.fonts && viewItem =~ /iconotype.icon/",
          "group": "iconotype@2"
        },
        {
          "command": "iconotype.flattenIcon",
          "when": "view == iconotype.fonts && viewItem =~ /iconotype.icon/",
          "group": "iconotype@3"
        }
      ],
      "explorer/context": [
        {
          "command": "iconotype.export",
          "when": "resourceFilename =~ /\\.iconotype\\.json$/",
          "group": "iconotype"
        },
        {
          "command": "iconotype.importProject",
          "when": "resourceExtname =~ /\\.(json|zip)$/ && !(resourceFilename =~ /\\.iconotype\\.json$/)",
          "group": "iconotype"
        }
      ],
      "commandPalette": [
        {
          "command": "iconotype.revealIcon",
          "when": "false"
        },
        {
          "command": "iconotype.removeIcon",
          "when": "false"
        },
        {
          "command": "iconotype.toggleIcon",
          "when": "false"
        },
        {
          "command": "iconotype.replaceIcon",
          "when": "false"
        },
        {
          "command": "iconotype.flattenIcon",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Iconotype",
      "properties": {
        "iconotype.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Icon font files to load, relative to each workspace folder. Leave empty to discover every `*.iconotype.json` automatically.",
          "scope": "resource"
        },
        "iconotype.defaults.fontsDir": {
          "type": "string",
          "default": "fonts",
          "markdownDescription": "Where font files are written for projects that do not set `output.fonts.dir` themselves. Example: `app/fonts`.",
          "scope": "resource"
        },
        "iconotype.defaults.stylesDir": {
          "type": "string",
          "default": "css",
          "markdownDescription": "Where the stylesheet or variables file is written for projects that do not configure it. Example: `app/css`.",
          "scope": "resource"
        },
        "iconotype.defaults.styleKind": {
          "type": "string",
          "default": "css",
          "enum": [
            "css",
            "scss",
            "less",
            "scss-variables",
            "less-variables",
            "css-variables",
            "json",
            "dart"
          ],
          "enumDescriptions": [
            "@font-face and one rule per icon",
            "The same, as .scss",
            "The same, as .less",
            "$app-home: \"\\e900\"; — variables only",
            "@app-home: \"\\e900\"; — variables only",
            ":root { --app-home: \"\\e900\" }",
            "{ \"home\": \"e900\" } — for tooling",
            "A Flutter IconData class"
          ],
          "scope": "resource"
        },
        "iconotype.defaults.formats": {
          "type": "array",
          "default": [
            "woff2",
            "woff",
            "ttf"
          ],
          "items": {
            "type": "string",
            "enum": [
              "woff2",
              "woff",
              "ttf",
              "svg"
            ]
          },
          "description": "Font formats to write when a project does not specify its own.",
          "scope": "resource"
        },
        "iconotype.autoExport": {
          "type": "string",
          "enum": [
            "off",
            "onSave",
            "onChange"
          ],
          "enumDescriptions": [
            "Export only when you ask. The status bar says when files are out of date.",
            "Export when the project file is saved.",
            "Export as soon as anything changes — a toggle in the grid, an edit in the editor."
          ],
          "default": "off",
          "markdownDescription": "When to write font files and stylesheets. `onChange` keeps the build always current at the cost of a font build per edit (debounced).",
          "scope": "resource"
        },
        "iconotype.exportOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Deprecated: use `#iconotype.autoExport#`. `true` still means `onSave`.",
          "scope": "resource"
        },
        "iconotype.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the icon itself next to references like `app-home` in your code."
        },
        "iconotype.usage.scanOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Scan the workspace for icon usage when the window opens. Off by default on large repositories."
        },
        "iconotype.usage.include": {
          "type": "string",
          "default": "",
          "markdownDescription": "Glob of files to search for icon references. Empty uses a sensible default covering web source files.",
          "scope": "resource"
        },
        "iconotype.usage.exclude": {
          "type": "string",
          "default": "",
          "markdownDescription": "Raw glob of files to skip, overriding `#iconotype.usage.excludeDirs#` entirely. Only needed for something a directory list cannot express.",
          "scope": "resource"
        },
        "iconotype.usage.excludeDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "dist",
            "build",
            "out",
            "target",
            "coverage",
            "vendor",
            "platforms",
            "Pods",
            ".git",
            ".gradle",
            ".yarn",
            ".bundle",
            ".svelte-kit",
            ".next",
            ".nuxt",
            ".output",
            ".venv",
            "__pycache__"
          ],
          "markdownDescription": "Directory names skipped when scanning for icon usage, at any depth. Remove one to scan it. A generated copy of your source — `platforms/` in a mobile project, a vendored `.yarn/` — can be tens of thousands of files and will exhaust `#iconotype.usage.maxFiles#` before your own code is reached.",
          "scope": "resource"
        },
        "iconotype.usage.useWorkspaceExcludes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also skip whatever `#search.exclude#` and `#files.exclude#` already hide, on top of `#iconotype.usage.excludeDirs#`.",
          "scope": "resource"
        },
        "iconotype.usage.maxFiles": {
          "type": "number",
          "default": 40000,
          "minimum": 1,
          "markdownDescription": "Most files one usage scan will read. Hitting it makes the result partial, which is reported rather than passed off as \"unused\".",
          "scope": "resource"
        },
        "iconotype.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn about references to icons that do not exist, or that are excluded from the built font."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.iconotype.json",
        "url": "./schema/iconfont.schema.json"
      },
      {
        "fileMatch": "*.glyphsmith.json",
        "url": "./schema/iconfont.schema.json"
      }
    ],
    "viewsWelcome": [
      {
        "view": "iconotype.fonts",
        "contents": "No icon font in this workspace yet.\n\nImport an existing IcoMoon project, a font package zip, or a folder of SVGs.\n[Import IcoMoon project…](command:iconotype.importProject)\n\nOr start from nothing:\n[New icon font](command:iconotype.newFont)"
      },
      {
        "view": "iconotype.usage",
        "contents": "Find every place your icons are referenced.\n[Scan icon usage](command:iconotype.scanUsage)",
        "when": "iconotype.hasFonts"
      }
    ]
  },
  "scripts": {
    "build": "vite build -c vite.webview.config.ts && node build.mjs",
    "test": "pnpm build && node ./test/runTest.cjs",
    "package": "pnpm build && vsce package --no-dependencies --out iconotype.vsix"
  },
  "dependencies": {},
  "devDependencies": {
    "@iconotype/build-config": "workspace:*",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "glob": "^11.0.0",
    "mocha": "^11.0.0",
    "@iconotype/core-host": "workspace:*",
    "@iconotype/core-model": "workspace:*",
    "@iconotype/ui": "workspace:*",
    "@iconotype/core-export": "workspace:*",
    "@iconotype/core-svg": "workspace:*",
    "@vscode/vsce": "^3.9.2",
    "css-tree": "^3.2.1"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "icon font",
    "icomoon",
    "svg",
    "woff2",
    "webfont",
    "icons",
    "fonticon",
    "glyph"
  ],
  "galleryBanner": {
    "color": "#0e1014",
    "theme": "dark"
  },
  "homepage": "https://iconotype.github.io/iconotype/",
  "bugs": {
    "url": "https://github.com/iconotype/iconotype/issues"
  },
  "qna": "https://github.com/iconotype/iconotype/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iconotype/iconotype"
  },
  "description": "Manage a project's icon fonts: grid, inline previews, autocompletion, usage, and one-click export to your build."
}
